{
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "excludeFiles": "{.github,docs,tests,tools,scripts,scratch,katex-fonts,dist,build}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' blob: https://vercel.com https://blob.vercel-storage.com https://*.blob.vercel-storage.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://huggingface.co https://cas-bridge.xethub.hf.co https://cas-server.xethub.hf.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geocoding-api.open-meteo.com https://nominatim.openstreetmap.org https://overpass-api.de https://ipapi.co https://ipwho.is https://freeipapi.com https://api.coingecko.com https://query1.finance.yahoo.com https://api.dictionaryapi.dev https://en.wikipedia.org; worker-src 'self' blob:; frame-src 'self' https://maps.google.com https://www.google.com https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/code-sandbox.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.json"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/diagnostics?__route=feedback"
    },
    {
      "source": "/api/favicon",
      "destination": "/api/diagnostics?__route=favicon"
    },
    {
      "source": "/api/favicons",
      "destination": "/api/diagnostics?__route=favicon"
    },
    {
      "source": "/favicons",
      "destination": "/api/diagnostics?__route=favicon"
    },
    {
      "source": "/favicon",
      "destination": "/api/diagnostics?__route=favicon"
    },
    {
      "source": "/api/extract-url",
      "destination": "/api/diagnostics?__route=extract-url"
    },
    {
      "source": "/api/current-facts",
      "destination": "/api/diagnostics?__route=current-facts"
    },
    {
      "source": "/api/markets",
      "destination": "/api/diagnostics?__route=markets"
    },
    {
      "source": "/api/rank-texts",
      "destination": "/api/diagnostics?__route=rank-texts"
    },
    {
      "source": "/api/verify",
      "destination": "/api/diagnostics?__route=verify"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": null,
  "outputDirectory": "dist"
}
