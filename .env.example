# UNIFY ASSISTANT ENVIRONMENT CONFIGURATION
# Copy this file to .env or .env.local and fill in your keys.

# Chat provider - Groq (select explicitly with GROQ_MODEL when preferred)
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=

# Chat and vision provider - Gemini (default preference when both are configured)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# --- LIVE WEB SEARCH (REQUIRED to enable web search) --------------------------
# Enable live web search. Set to true for Perplexity-style web-grounded answers.
# Without this, all web search routes are silently skipped.
LIVE_RETRIEVAL_ENABLED=false

# Enable general web search mode
WEB_SEARCH_ENABLED=false

# The research loop uses public search providers and local ranking by default.
# Google Search grounding is disabled: it can be billed separately from text generation.
# Only opt in after verifying a free search-grounding allowance for your account/model.
# SEARCH_GEMINI_GROUNDING_FREE_ALLOWANCE=true

# Optional browser rendering for pages that raw HTML extraction cannot read.
# Point to an existing/self-hosted Crawl4AI service; no new service is required.
# CRAWL4AI_URL=https://your-existing-crawler.example.com
# CRAWL4AI_API_TOKEN=

# --- SEARXNG (Zero-config - works without any API key) ------------------------
# SearXNG is a free, privacy-respecting metasearch engine aggregating Google,
# Bing, DuckDuckGo, Brave, Wikipedia, and 70+ other search engines.
#
# Option A - No setup needed: leave SEARXNG_URL blank.
#   The app automatically races 4 public SearXNG instances as fallback.
#   Public instances have independent quotas and may reject requests.
#
# Option B - Use your own instance for best reliability (recommended for prod):
#   Use an existing/self-hosted SearXNG instance; no extra hosting is required.
#   Paste its URL below. Docker image: searxng/searxng
# SEARXNG_URL=https://your-searxng-instance.up.railway.app

# --- OPTIONAL PAID SEARCH PROVIDERS ------------------------------------------
# Serper.dev - Google Search API (verify your account's free allowance first)
# Sign up at: https://serper.dev
# Adds full Google index quality on top of free sources.
# SERPER_API_KEY=

# Exa.ai - Neural semantic search (verify your account's free allowance first)
# Sign up at: https://exa.ai
# EXA_API_KEY=

# --- OPTIONAL: LOCAL DEVELOPMENT ---------------------------------------------
PORT=3000
HOST=127.0.0.1

# --- OPTIONAL: ENTERPRISE COMPLIANCE & OBSERVABILITY (Zero-Cost / In-Browser by Default) --
# Data Loss Prevention: 'personal' (default, client-only confirmation) or 'enforced' (hard blocking)
# DLP_POLICY_MODE=personal
# DLP_ENABLED=true
# FEEDBACK_ENABLED=true

# Optional External Telemetry Exporter (OpenTelemetry / Langfuse) - defaults to off if unset
# TELEMETRY_EXPORT_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer my-token
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com


# Persistent saved BYOK requires BOTH matching RSA PEM keys (2048+ bits).
# Keep these stable across all server instances. Do not commit real private keys.
# JARVIS_BYOK_PRIVATE_KEY=
# JARVIS_BYOK_PUBLIC_KEY=

# Anonymous AI Horde community queue, directly in the browser. Set false to hide.
JARVIS_IMAGE_GENERATION_ENABLED=true

# Remote extraction requires public-only egress controls on the renderer itself.
# This flag confirms those controls; it does not install a network policy.
# CRAWL4AI_PUBLIC_EGRESS_VERIFIED=true

# Optional exact additional browser origins, including scheme and port.
# Same-origin production requests work without this setting. No wildcards.
# CORS_ALLOWED_ORIGINS=https://your-approved-preview.vercel.app
